SURVEY_SOLUTIONS_BASE_URL=http://host.docker.internal:8080
SURVEY_SOLUTIONS_USERNAME=
SURVEY_SOLUTIONS_PASSWORD=
ANALYTICS_ALLOWED_ORIGIN=http://localhost:8088# Statuts HQ pris en compte dans les analyses de variables (séparés par des virgules)
ANALYTICS_STATUSES=Completed,ApprovedBySupervisor,ApprovedByHeadquarters
# Workspace HQ (laisser vide pour une instance HQ sans workspaces)
SURVEY_SOLUTIONS_WORKSPACE=primary
# Mot de passe de la base PostgreSQL Analytics (conteneur dédié, non exposé)
ANALYTICS_DB_PASSWORD=
# Fréquence de synchronisation automatique (format ISO-8601, ex. PT30M = 30 minutes)
ANALYTICS_SYNC_INTERVAL=PT30M
# Organisme affiché en en-tête des rapports PDF
ANALYTICS_REPORT_ORGANIZATION=Survey Solutions Analytics
# Génération automatique des rapports PDF (cron Spring, heure de Dakar) : 7 h chaque jour
ANALYTICS_REPORT_CRON=0 0 7 * * *
